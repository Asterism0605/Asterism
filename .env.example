# 前端環境變數範本。
# 複製成 .env 並填入實際值；.env 已被 gitignore，請勿提交真實密鑰。
# 注意：Vite 只會把「VITE_ 開頭」的變數注入前端，其餘前綴前端讀不到。

# 後端 API base URL（本機開發可在 .env 覆寫為 http://localhost:3001）
VITE_API_BASE_URL=https://asterism-backend.onrender.com

# Supabase（帳密登入 / 圖片資料）
# 值在 Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-publishable-key>
